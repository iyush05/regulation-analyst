  "components": {
    "schemas": {
      "AgentRequest": {
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "consolidated",
              "standalone"
            ],
            "title": "Scope",
            "default": "consolidated"
          },
          "basis": {
            "type": "string",
            "enum": [
              "Ind AS",
              "IFRS"
            ],
            "title": "Basis",
            "default": "Ind AS"
          },
          "policy": {
            "type": "string",
            "enum": [
              "latest_available",
              "originally_reported"
            ],
            "title": "Policy",
            "default": "latest_available"
          },
          "trust": {
            "type": "string",
            "enum": [
              "reviewed_only",
              "allow_automated"
            ],
            "title": "Trust",
            "default": "allow_automated"
          },
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "allow_ingest": {
            "type": "boolean",
            "title": "Allow Ingest",
            "default": false
          },
          "llm_resolve": {
            "type": "boolean",
            "title": "Llm Resolve",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AgentRequest"
      },
      "AskRequest": {
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "consolidated",
              "standalone"
            ],
            "title": "Scope",
            "default": "consolidated"
          },
          "basis": {
            "type": "string",
            "enum": [
              "Ind AS",
              "IFRS"
            ],
            "title": "Basis",
            "default": "Ind AS"
          },
          "policy": {
            "type": "string",
            "enum": [
              "latest_available",
              "originally_reported"
            ],
            "title": "Policy",
            "default": "latest_available"
          },
          "trust": {
            "type": "string",
            "enum": [
              "reviewed_only",
              "allow_automated"
            ],
            "title": "Trust",
            "default": "allow_automated"
          },
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "Body_upload_api_ingest_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "company": {
            "type": "string",
            "minLength": 2,
            "title": "Company"
          },
          "years": {
            "type": "string",
            "title": "Years",
            "description": "Comma-separated, e.g. FY24,FY25"
          }
        },
        "type": "object",
        "required": [
          "file",
          "company",
          "years"
        ],
        "title": "Body_upload_api_ingest_upload_post"
      },
      "CompareRequest": {
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "consolidated",
              "standalone"
            ],
            "title": "Scope",
            "default": "consolidated"
          },
          "basis": {
            "type": "string",
            "enum": [
              "Ind AS",
              "IFRS"
            ],
            "title": "Basis",
            "default": "Ind AS"
          },
          "policy": {
            "type": "string",
            "enum": [
              "latest_available",
              "originally_reported"
            ],
            "title": "Policy",
            "default": "latest_available"
          },
          "trust": {
            "type": "string",
            "enum": [
              "reviewed_only",
              "allow_automated"
            ],
            "title": "Trust",
            "default": "allow_automated"
          },
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "companies": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 2,
            "title": "Companies"
          },
          "years": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Years"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "metric",
          "companies",
          "years"
        ],
        "title": "CompareRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestRequest": {
        "properties": {
          "company": {
            "type": "string",
            "maxLength": 200,
            "minLength": 2,
            "title": "Company"
          },
          "years": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Years"
          },
          "urls": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Urls"
          },
          "llm_resolve": {
            "type": "boolean",
            "title": "Llm Resolve",
            "default": false
          },
          "remap": {
            "type": "boolean",
            "title": "Remap",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "company",
          "years"
        ],
        "title": "IngestRequest"
      },
      "Job": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "agent",
              "ingest"
            ],
            "title": "Kind"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "done",
              "failed"
            ],
            "title": "Status"
          },
          "request": {
            "additionalProperties": true,
            "type": "object",
            "title": "Request"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "progress": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Progress"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "status",
          "request",
          "created_at"
        ],
        "title": "Job"
      },
      "Result": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "partial",
              "not_found",
              "ambiguous",
              "invalid_request",
              "undefined",
              "out_of_scope"
            ],
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "corpus_version": {
            "type": "string",
            "title": "Corpus Version"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "status",
          "message",
          "corpus_version"
        ],
        "title": "Result"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
