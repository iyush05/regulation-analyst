# Export these variables in your shell. The application does not auto-load .env.
# Never commit a real API key.
# Model provider for the agent, layout reading, and discovery: openai (default) or bedrock.
REGULATION_MODEL_PROVIDER=openai
OPENAI_API_KEY=
# For bedrock: a Bedrock API key and region; REGULATION_AGENT_MODEL is then a Bedrock model or
# inference-profile ID with tool use. Bedrock has no web search, so new companies need --url.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
REGULATION_AGENT_MODEL=
REGULATION_ANALYST_DB=data/research.sqlite3

# Genuine embeddings: OpenAI API or a local SentenceTransformer directory.
REGULATION_EMBEDDING_PROVIDER=openai
REGULATION_EMBEDDING_MODEL=text-embedding-3-small
# For local search: provider=local, model=/absolute/model/path, revision=your-pinned-revision
REGULATION_EMBEDDING_REVISION=

# Optional local cross-encoder. Requires the local-search extra and model weights.
REGULATION_RERANKER_PATH=
REGULATION_RERANKER_REVISION=

# OCR: directory containing Tesseract traineddata files.
TESSDATA_PREFIX=

# Hosted read-only MCP, served by the existing `api` command at /mcp/.
# Empty object disables the endpoint. Use unique random 32+ character tokens per buyer.
# Configure the actual JSON mapping in Render's secret environment settings, not in git.
REGULATION_MCP_TOKENS={}
REGULATION_MCP_REQUESTS_PER_MINUTE=120
# On Render, allowed hosts default to RENDER_EXTERNAL_HOSTNAME. For custom domains,
# set a comma-separated list of exact hostnames. No scheme or path.
# REGULATION_MCP_ALLOWED_HOSTS=regulation-analyst-api.onrender.com
# Optional, exact browser origins. Native MCP clients do not need these.
REGULATION_MCP_ALLOWED_ORIGINS=
